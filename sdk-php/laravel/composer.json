{
  "name": "fastapify/laravel",
  "description": "FastAPI developer experience for Laravel - Automatic validation and OpenAPI generation",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Fastapify Maintainers"
    }
  ],
  "require": {
    "php": "^8.0 || ^8.1 || ^8.2 || ^8.3",
    "illuminate/http": "^9.0 || ^10.0 || ^11.0",
    "illuminate/support": "^9.0 || ^10.0 || ^11.0",
    "illuminate/validation": "^9.0 || ^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Fastapify\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Fastapify\\Laravel\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0 || ^11.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Fastapify\\Laravel\\FastapifyServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable"
}
