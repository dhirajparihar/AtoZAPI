{
  "name": "@atozapi/cli",
  "version": "0.1.1",
  "description": "AtoZAPI CLI - Automatic OpenAPI generation and Swagger UI server for polyglot backends",
  "main": "index.js",
  "bin": {
    "atozapi": "index.js"
  },
  "type": "commonjs",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhirajparihar/AtoZAPI.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/dhirajparihar/AtoZAPI#readme",
  "bugs": {
    "url": "https://github.com/dhirajparihar/AtoZAPI/issues"
  },
  "files": [
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node index.js serve",
    "generate": "node index.js generate",
    "build:binaries": "npx -y pkg . --out-path dist"
  },
  "pkg": {
    "scripts": "index.js",
    "targets": [
      "node18-linux-x64",
      "node18-macos-x64",
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "keywords": [
    "atozapi",
    "fastapi",
    "openapi",
    "swagger",
    "cli",
    "documentation"
  ],
  "author": "AtoZAPI Maintainers",
  "license": "MIT"
}
